{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/.envrc)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/env.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.cert)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.ppk)",
      "Read(**/*.kdbx)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.token)",
      "Read(**/token)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_dsa*)",
      "Read(**/*-service-account.json)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/client_secret_*.json)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/auth.json)",
      "Read(**/oauth_creds.json)",
      "Read(**/.git-credentials)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/key.properties)",
      "Read(**/keystores/**)",
      "Read(**/secrets/**)",
      "Read(**/secrets.enc)",
      "Read(**/.secrets.key)",
      "Read(**/.env-*)",
      "Read(**/*.tfstate.backup)",
      "Read(**/secrets.properties)",
      "Read(**/local.properties)",
      "Read(/credentials/**)",
      "Read(/backups/**)",
      "Read(**/*.db)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(**/*.dump)",
      "Read(**/*.sql.gz)",
      "Read(**/*.sql.gz.enc)",
      "Read(**/play-publisher.json)",
      "Read(**/api-project-*.json)",
      "Read(**/*.db-shm)",
      "Read(**/*.db-wal)",
      "Read(**/*_token)",
      "Read(**/*-token)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git *--no-veri*)",
      "Bash(git commit -n *)",
      "Bash(git *core.hooksPath*)",
      "Bash(git *core.hookspath*)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Edit(.githooks/**)",
      "Write(.githooks/**)",
      "Edit(scripts/sensitive-paths.sh)",
      "Write(scripts/sensitive-paths.sh)",
      "Edit(.gitleaks.toml)",
      "Write(.gitleaks.toml)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyWrite": [
        "./.githooks",
        "./.gitleaks.toml",
        "./scripts/sensitive-paths.sh",
        "./scripts/setup-hooks.sh"
      ]
    }
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": []
}
